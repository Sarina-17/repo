    "*": {
      "files": {
        "sketch.ino": "// Mokxi.\n// This circuit has no board, so Run simulates the parts only.\n// Add a board and pick a program in its Firmware panel: the editor then shows\n// that program's source, and Run builds what you type here for that board.\n\nvoid setup() {\n  pinMode(13, OUTPUT);\n  Serial.begin(115200);\n}\n\nvoid loop() {\n  digitalWrite(13, HIGH);\n  delay(500);\n  digitalWrite(13, LOW);\n  delay(500);\n}\n"
      },
      "main": "sketch.ino"
    },
    "esp321": {
      "files": {
        "sketch.ino": "#include <Arduino.h>\n#include <Wire.h>\n#include <LiquidCrystal_I2C.h>\n\n// ================= LCD =================\nLiquidCrystal_I2C lcd(0x27, 16, 2);\n\n// ================= LINE SENSORS =================\nconst int linePins[5] = {34, 35, 36, 39, 26};\nconst int LINE_THRESHOLD = 2000;\n\n// ================= ULTRASONIC =================\nconst int TRIG = 5;\nconst int ECHO = 18;\nconst int OBSTACLE_LIMIT = 20;  // cm\n\n// ================= PACKAGE SENSOR =================\nconst int PACKAGE_SENSOR = 27;\n\n// ================= DOCK SWITCHES =================\nconst int DOCK1 = 32;\nconst int DOCK2 = 33;\n\n// ================= EMERGENCY STOP =================\nconst int ESTOP = 25;\n\n// ================= FRONT MOTOR DRIVER =================\nconst int FL_IN1 = 13;\nconst int FL_IN2 = 14;\nconst int FR_IN1 = 16;\nconst int FR_IN2 = 17;\n\n// ================= REAR MOTOR DRIVER =================\nconst int RL_IN1 = 19;\nconst int RL_IN2 = 23;\nconst int RR_IN1 = 4;\nconst int RR_IN2 = 15;\n\n// ================= SPEED SETTINGS =================\nint baseSpeed = 130;\nint turnSpeed = 90;\n\n// ================= SYSTEM STATE =================\nbool packageDetected = false;\nint distanceCM = -1;\n\n// =================================================\n// SETUP\n// =================================================\n\nvoid setup() {\n  Serial.begin(115200);\n\n  // Line sensors\n  for (int i = 0; i < 5; i++) {\n    pinMode(linePins[i], INPUT);\n  }\n\n  // Ultrasonic\n  pinMode(TRIG, OUTPUT);\n  pinMode(ECHO, INPUT);\n\n  // Package sensor\n  pinMode(PACKAGE_SENSOR, INPUT);\n\n  // Dock switches\n  pinMode(DOCK1, INPUT_PULLUP);\n  pinMode(DOCK2, INPUT_PULLUP);\n\n  // Emergency stop\n  pinMode(ESTOP, INPUT_PULLUP);\n\n  // Motor pins\n  pinMode(FL_IN1, OUTPUT);\n  pinMode(FL_IN2, OUTPUT);\n  pinMode(FR_IN1, OUTPUT);\n  pinMode(FR_IN2, OUTPUT);\n  pinMode(RL_IN1, OUTPUT);\n  pinMode(RL_IN2, OUTPUT);\n  pinMode(RR_IN1, OUTPUT);\n  pinMode(RR_IN2, OUTPUT);\n\n  // LCD\n  lcd.init();\n  lcd.backlight();\n\n  stopMotors();\n\n  lcd.setCursor(0, 0);\n  lcd.print(\"Carrier Starting\");\n  delay(1000);\n\n  lcd.clear();\n  lcd.print(\"System Ready\");\n\n  Serial.println(\"Carrier Ready\");\n}\n\n// =================================================\n// MAIN LOOP\n// =================================================\n\nvoid loop() {\n\n  // 1. Emergency stop\n  if (digitalRead(ESTOP) == LOW) {\n    stopMotors();\n    displayStatus(\"EMERGENCY STOP\");\n    return;\n  }\n\n  // 2. Dock detection\n  if (digitalRead(DOCK1) == LOW ||\n      digitalRead(DOCK2) == LOW) {\n    stopMotors();\n    displayStatus(\"DOCKED\");\n    return;\n  }\n\n  // 3. Check obstacle\n  distanceCM = getDistance();\n\n  if (distanceCM > 0 && distanceCM <= OBSTACLE_LIMIT) {\n    stopMotors();\n    displayStatus(\"OBSTACLE\");\n    return;\n  }\n\n  // 4. Check package\n  packageDetected = digitalRead(PACKAGE_SENSOR);\n\n  // 5. Follow line\n  followLine();\n\n  // 6. Serial output\n  Serial.print(\"Distance: \");\n  Serial.print(distanceCM);\n  Serial.print(\" cm | Package: \");\n  Serial.println(packageDetected ? \"Detected\" : \"Absent\");\n\n  delay(20);\n}\n\n// =================================================\n// LINE FOLLOWING\n// =================================================\n\nvoid followLine() {\n\n  int values[5];\n\n  for (int i = 0; i < 5; i++) {\n    values[i] = analogRead(linePins[i]);\n  }\n\n  bool s1 = values[0] > LINE_THRESHOLD;\n  bool s2 = values[1] > LINE_THRESHOLD;\n  bool s3 = values[2] > LINE_THRESHOLD;\n  bool s4 = values[3] > LINE_THRESHOLD;\n  bool s5 = values[4] > LINE_THRESHOLD;\n\n  if (s3) {\n    moveForward(baseSpeed, baseSpeed);\n  }\n  else if (s2) {\n    moveForward(turnSpeed, baseSpeed);\n  }\n  else if (s1) {\n    moveForward(0, baseSpeed);\n  }\n  else if (s4) {\n    moveForward(baseSpeed, turnSpeed);\n  }\n  else if (s5) {\n    moveForward(baseSpeed, 0);\n  }\n  else {\n    stopMotors();\n  }\n}\n\n// =================================================\n// MOTOR CONTROL\n// =================================================\n\nvoid motorControl(int pin1, int pin2, int speedValue) {\n\n  speedValue = constrain(speedValue, -255, 255);\n\n  if (speedValue > 0) {\n    analogWrite(pin1, speedValue);\n    analogWrite(pin2, 0);\n  }\n  else if (speedValue < 0) {\n    analogWrite(pin1, 0);\n    analogWrite(pin2, abs(speedValue));\n  }\n  else {\n    analogWrite(pin1, 0);\n    analogWrite(pin2, 0);\n  }\n}\n\nvoid moveForward(int leftSpeed, int rightSpeed) {\n\n  motorControl(FL_IN1, FL_IN2, leftSpeed);\n  motorControl(RL_IN1, RL_IN2, leftSpeed);\n\n  motorControl(FR_IN1, FR_IN2, rightSpeed);\n  motorControl(RR_IN1, RR_IN2, rightSpeed);\n}\n\nvoid stopMotors() {\n\n  motorControl(FL_IN1, FL_IN2, 0);\n  motorControl(FR_IN1, FR_IN2, 0);\n  motorControl(RL_IN1, RL_IN2, 0);\n  motorControl(RR_IN1, RR_IN2, 0);\n}\n\n// =================================================\n// ULTRASONIC SENSOR\n// =================================================\n\nint getDistance() {\n\n  digitalWrite(TRIG, LOW);\n  delayMicroseconds(2);\n\n  digitalWrite(TRIG, HIGH);\n  delayMicroseconds(10);\n\n  digitalWrite(TRIG, LOW);\n\n  long duration = pulseIn(ECHO, HIGH, 30000);\n\n  if (duration == 0) {\n    return -1;\n  }\n\n  return (int)(duration * 0.0343 / 2);\n}\n\n// =================================================\n// LCD STATUS\n// =================================================\n\nvoid displayStatus(const char* message) {\n\n  lcd.clear();\n  lcd.setCursor(0, 0);\n  lcd.print(message);\n\n  Serial.println(message);\n}"
      },
      "main": "sketch.ino"
    }
  }
